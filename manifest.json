{
  "manifest_version": 3,
  "name": "DevSaathi",
  "version": "0.1.0",
  "description": "AI Learning Companion",

  "web_accessible_resources": [
    {
      "resources": [
        "pageHook.js"
      ],
      "matches": [
        "https://leetcode.com/*"
      ]
    }
  ],

  "permissions": [
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "https://leetcode.com/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "content/platforms/leetcode/index.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html"
  }
}